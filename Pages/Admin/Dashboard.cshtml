@page
@using Healthcare_Industry.Models
@model Healthcare_Industry.Pages.Admin.DashboardModel
@{
	Layout = null;
	ViewData["Title"] = "Dashboard";
	decimal maxTrend = Model.TrendValues.Any() ? Math.Max(Model.TrendValues.Max(), 1) : 1;
	decimal maxCat = Model.CategoryBreakdown.Any() ? Model.CategoryBreakdown.Max(c => c.Revenue) : 1;
	int maxStatus = Model.StatusBreakdown.Any() ? Model.StatusBreakdown.Max(s => s.Count) : 1;
}
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>WellNest Admin — Dashboard</title>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;1,500&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&display=swap" rel="stylesheet">
	<style>
		:root {
			--bg: #f0f6ff;
			--card: #fff;
			--navy: #0d2454;
			--primary: #1246a0;
			--accent: #2979ff;
			--mist: #ddeeff;
			--pale: #eef6ff;
			--ink: #08172e;
			--ink2: #1a3251;
			--slate: #3a5a80;
			--steel: #6b8db0;
			--gold: #c8971e;
			--coral: #e8524a;
			--mint: #00a896;
			--orange: #f97316;
			--s1: 0 1px 4px rgba(10,31,68,.06),0 2px 8px rgba(10,31,68,.04);
			--s2: 0 4px 18px rgba(10,31,68,.09),0 1px 4px rgba(10,31,68,.05);
		}

		* {
			margin: 0;
			padding: 0;
			box-sizing: border-box
		}

		body {
			font-family: 'DM Sans',sans-serif;
			background: var(--bg);
			color: var(--ink);
			font-size: 15.5px
		}

		a {
			text-decoration: none;
			color: inherit
		}

		.topbar {
			background: #fff;
			border-bottom: 1px solid var(--mist);
			box-shadow: var(--s1);
			position: sticky;
			top: 0;
			z-index: 20
		}

		.topbar-in {
			max-width: 1180px;
			margin: 0 auto;
			padding: 14px 24px;
			display: flex;
			align-items: center;
			gap: 28px
		}

		.logo {
			display: flex;
			align-items: center;
			gap: 10px
		}

		.orb {
			width: 38px;
			height: 38px;
			border-radius: 11px;
			background: linear-gradient(135deg,var(--primary),var(--accent));
			display: grid;
			place-items: center;
			color: #fff;
			font-size: 19px;
			box-shadow: 0 4px 12px rgba(41,121,255,.35)
		}

		.logo .name {
			font-family: 'Lora',serif;
			font-weight: 600;
			font-size: 21px;
			color: var(--navy)
		}

			.logo .name span {
				color: var(--accent)
			}

		.logo .tag {
			font-size: 11px;
			font-weight: 700;
			letter-spacing: .5px;
			color: var(--steel);
			text-transform: uppercase;
			margin-left: 4px
		}

		.nav {
			display: flex;
			gap: 6px
		}

			.nav a {
				padding: 8px 14px;
				border-radius: 9px;
				font-weight: 600;
				font-size: 14.5px;
				color: var(--slate);
				transition: .15s
			}

				.nav a:hover {
					background: var(--pale);
					color: var(--primary)
				}

				.nav a.active {
					background: linear-gradient(135deg,var(--primary),var(--accent));
					color: #fff
				}

		.logout {
			margin-left: auto
		}

			.logout button {
				font-family: 'DM Sans';
				font-weight: 600;
				font-size: 14px;
				color: var(--slate);
				background: var(--pale);
				border: none;
				padding: 8px 16px;
				border-radius: 9px;
				cursor: pointer;
				transition: .15s
			}

				.logout button:hover {
					background: var(--mist);
					color: var(--coral)
				}

		.wrap {
			max-width: 1180px;
			margin: 0 auto;
			padding: 28px 24px 60px
		}

		.page-head {
			margin-bottom: 22px
		}

			.page-head h1 {
				font-family: 'Lora',serif;
				font-style: italic;
				font-weight: 600;
				font-size: 30px;
				color: var(--navy)
			}

			.page-head p {
				color: var(--steel);
				font-size: 14.5px;
				margin-top: 3px
			}

		/* ---- stat cards ---- */
		.stats {
			display: grid;
			grid-template-columns: repeat(4,1fr);
			gap: 18px;
			margin-bottom: 28px
		}

		.stat {
			background: var(--card);
			border-radius: 16px;
			box-shadow: var(--s2);
			border: 1px solid var(--mist);
			padding: 22px 24px;
			position: relative;
			overflow: hidden
		}

			.stat .ico {
				width: 42px;
				height: 42px;
				border-radius: 11px;
				display: grid;
				place-items: center;
				font-size: 21px;
				margin-bottom: 14px
			}

			.stat .num {
				font-family: 'Lora',serif;
				font-weight: 600;
				font-size: 34px;
				line-height: 1;
				color: var(--navy)
			}

			.stat .lbl {
				font-size: 13.5px;
				font-weight: 600;
				color: var(--steel);
				margin-top: 6px
			}

		.i-blue {
			background: rgba(41,121,255,.12);
			color: var(--primary)
		}

		.i-orange {
			background: rgba(249,115,22,.14);
			color: var(--orange)
		}

		.i-coral {
			background: rgba(232,82,74,.13);
			color: var(--coral)
		}

		.i-mint {
			background: rgba(0,168,150,.14);
			color: var(--mint)
		}

		/* ---- quick links ---- */
		.section-title {
			font-family: 'Lora',serif;
			font-style: italic;
			font-weight: 600;
			font-size: 20px;
			color: var(--navy);
			margin: 6px 0 16px
		}

		.quick {
			display: grid;
			grid-template-columns: repeat(3,1fr);
			gap: 18px;
			margin-bottom: 30px
		}

		.qcard {
			background: var(--card);
			border-radius: 16px;
			box-shadow: var(--s2);
			border: 1px solid var(--mist);
			padding: 22px 24px;
			display: flex;
			flex-direction: column;
			gap: 8px;
			transition: .18s
		}

			.qcard:hover {
				transform: translateY(-3px);
				box-shadow: 0 10px 26px rgba(10,31,68,.13);
				border-color: #c2deff
			}

			.qcard .qico {
				font-size: 24px
			}

			.qcard h3 {
				font-family: 'Lora',serif;
				font-style: italic;
				font-weight: 600;
				font-size: 18px;
				color: var(--navy)
			}

			.qcard p {
				font-size: 13.5px;
				color: var(--steel)
			}

			.qcard .go {
				margin-top: 6px;
				font-weight: 700;
				font-size: 14px;
				color: var(--primary)
			}

		/* ---- recent products ---- */
		.card {
			background: var(--card);
			border-radius: 16px;
			box-shadow: var(--s2);
			border: 1px solid var(--mist);
			padding: 24px 26px
		}

			.card .card-head {
				display: flex;
				align-items: center;
				justify-content: space-between;
				margin-bottom: 16px
			}

			.card h2 {
				font-family: 'Lora',serif;
				font-style: italic;
				font-weight: 600;
				font-size: 21px;
				color: var(--navy)
			}

			.card .seeall {
				font-weight: 700;
				font-size: 14px;
				color: var(--primary)
			}

		.tbl {
			width: 100%;
			border-collapse: collapse
		}

			.tbl th {
				text-align: left;
				font-size: 12px;
				text-transform: uppercase;
				letter-spacing: .5px;
				color: var(--steel);
				font-weight: 700;
				padding: 0 14px 12px
			}

			.tbl td {
				padding: 14px;
				border-top: 1px solid var(--mist);
				font-size: 14.5px;
				color: var(--ink2);
				vertical-align: middle
			}

			.tbl tr:hover td {
				background: var(--pale)
			}

		.pname {
			font-weight: 600;
			color: var(--ink)
		}

		.price {
			font-weight: 600;
			color: var(--primary)
		}

		.stock-low {
			color: var(--orange);
			font-weight: 700
		}

		.lab {
			font-size: 11px;
			font-weight: 700;
			color: #fff;
			padding: 3px 9px;
			border-radius: 6px;
			white-space: nowrap
		}

		.lab-NewArrival {
			background: var(--primary)
		}

		.lab-Bestseller {
			background: var(--gold)
		}

		.lab-Buy1Free1 {
			background: #059669
		}

		.lab-ThirtyOff {
			background: #dc2626
		}

		.lab-OnSale {
			background: var(--orange)
		}

		.lab-None {
			background: #c2deff;
			color: var(--slate)
		}


		/* ---- sales overview charts ---- */
		.sales-stats {
			display: grid;
			grid-template-columns: repeat(5,1fr);
			gap: 14px;
			margin-bottom: 22px
		}

		.sales-stat {
			background: #fff;
			border: 1px solid var(--mist);
			border-radius: 14px;
			box-shadow: var(--s1);
			padding: 18px 20px
		}

			.sales-stat .num {
				font-family: 'Lora',serif;
				font-weight: 600;
				font-size: 25px;
				color: var(--navy);
				line-height: 1
			}

			.sales-stat .lbl {
				font-size: 13px;
				font-weight: 600;
				color: var(--steel);
				margin-top: 6px
			}

		.sales-card {
			margin-bottom: 22px
		}

		.trend {
			display: flex;
			align-items: flex-end;
			gap: 7px;
			height: 180px;
			padding-top: 10px
		}

		.tbar {
			flex: 1;
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: flex-end;
			height: 100%
		}

			.tbar .bar {
				width: 100%;
				max-width: 26px;
				border-radius: 6px 6px 2px 2px;
				background: linear-gradient(180deg,var(--accent),var(--primary));
				transition: .2s;
				position: relative
			}

				.tbar .bar:hover {
					filter: brightness(1.08)
				}

			.tbar .day {
				font-size: 10.5px;
				color: var(--steel);
				margin-top: 8px;
				white-space: nowrap
			}

			.tbar .val {
				font-size: 10px;
				color: var(--primary);
				font-weight: 700;
				margin-bottom: 4px
			}

		.sales-cols {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 22px;
			margin-bottom: 22px
		}

		.tp-row {
			display: flex;
			align-items: center;
			gap: 12px;
			padding: 11px 0;
			border-bottom: 1px solid var(--mist)
		}

			.tp-row:last-child {
				border-bottom: none
			}

		.tp-rank {
			width: 26px;
			height: 26px;
			border-radius: 8px;
			background: var(--pale);
			color: var(--primary);
			font-weight: 700;
			font-size: 13px;
			display: grid;
			place-items: center;
			flex-shrink: 0
		}

		.tp-name {
			flex: 1;
			font-weight: 600;
			color: var(--ink2);
			font-size: 14.5px
		}

		.tp-qty {
			font-size: 12.5px;
			color: var(--steel)
		}

		.tp-rev {
			font-weight: 700;
			color: var(--primary);
			font-family: 'Lora',serif;
			white-space: nowrap
		}

		.hbar-row {
			margin-bottom: 14px
		}

			.hbar-row:last-child {
				margin-bottom: 0
			}

		.hbar-top {
			display: flex;
			justify-content: space-between;
			font-size: 13.5px;
			margin-bottom: 6px
		}

			.hbar-top b {
				color: var(--ink2);
				font-weight: 600
			}

			.hbar-top span {
				color: var(--primary);
				font-weight: 700
			}

		.hbar-track {
			height: 10px;
			background: var(--pale);
			border-radius: 6px;
			overflow: hidden
		}

		.hbar-fill {
			height: 100%;
			border-radius: 6px;
			background: linear-gradient(90deg,var(--primary),var(--accent))
		}

		.empty {
			text-align: center;
			color: var(--steel);
			padding: 40px;
			font-size: 15px
		}

			.empty a {
				color: var(--primary);
				font-weight: 700
			}

		@@media(max-width:900px) {
			.stats,
			.sales-stats {
				grid-template-columns: 1fr 1fr
			}

			.sales-cols,
			.quick {
				grid-template-columns: 1fr
			}
		}

		@@media(max-width:720px) {
			.nav {
				display: none
			}
		}
	</style>
</head>
<body>
	<header class="topbar">
		<div class="topbar-in">
			<a class="logo" asp-page="/Admin/Dashboard">
				<span class="orb">🌿</span>
				<span class="name">Well<span>Nest</span></span>
				<span class="tag">Admin</span>
			</a>
			<nav class="nav">
				<a asp-page="/Admin/Dashboard" class="active">Dashboard</a>
				<a asp-page="/Admin/ProductManagement">Products</a>
				<a asp-page="/Admin/OrderManagement">Orders</a>
				<a asp-page="/Admin/SalesDashboard">Sales</a>
			</nav>
			<form class="logout" method="post" asp-page="/Account/Logout">
				<button type="submit">Log out</button>
			</form>
		</div>
	</header>

	<div class="wrap">
		<div class="page-head">
			<h1>Welcome back, Admin</h1>
			<p>Here's a snapshot of your WellNest store.</p>
		</div>

		<!-- STAT CARDS -->
		<div class="stats">
			<div class="stat">
				<div class="ico i-blue">📦</div>
				<div class="num">@Model.TotalProducts</div>
				<div class="lbl">Total products</div>
			</div>
			<div class="stat">
				<div class="ico i-orange">⚠️</div>
				<div class="num">@Model.LowStock</div>
				<div class="lbl">Low stock (under 10)</div>
			</div>
			<div class="stat">
				<div class="ico i-coral">🚫</div>
				<div class="num">@Model.OutOfStock</div>
				<div class="lbl">Out of stock</div>
			</div>
			<div class="stat">
				<div class="ico i-mint">👥</div>
				<div class="num">@Model.TotalUsers</div>
				<div class="lbl">Registered users</div>
			</div>
		</div>


		<!-- SALES OVERVIEW -->
		<div class="section-title">Sales overview</div>

		<div class="sales-stats">
			<div class="sales-stat"><div class="num">RM@(Model.TotalRevenue.ToString("0.00"))</div><div class="lbl">Total revenue</div></div>
			<div class="sales-stat"><div class="num">@Model.TotalOrders</div><div class="lbl">Total orders</div></div>
			<div class="sales-stat"><div class="num">RM@(Model.AvgOrderValue.ToString("0.00"))</div><div class="lbl">Average order value</div></div>
			<div class="sales-stat"><div class="num">@Model.CancelledCount</div><div class="lbl">Cancelled orders</div></div>
			<div class="sales-stat"><div class="num" style="color:var(--gold);">RM@(Model.PendingCodAmount.ToString("0.00"))</div><div class="lbl">Pending COD</div></div>
		</div>

		<div class="card sales-card">
			<div class="card-head">
				<h2>Revenue — last 14 days</h2>
				<a class="seeall" asp-page="/Admin/SalesDashboard">View full sales →</a>
			</div>
			@if (Model.TrendValues.All(v => v == 0))
			{
				<div class="empty">No revenue recorded in the last 14 days.</div>
			}
			else
			{
				<div class="trend">
					@for (int i = 0; i < Model.TrendValues.Count; i++)
					{
						var pct = maxTrend > 0 ? (double)(Model.TrendValues[i] / maxTrend) * 100 : 0;
						<div class="tbar">
							@if (Model.TrendValues[i] > 0)
							{
								<div class="val">@(Model.TrendValues[i] >= 100 ? Model.TrendValues[i].ToString("0") : Model.TrendValues[i].ToString("0.0"))</div>
							}
							<div class="bar" style="height:@(Math.Max(pct, 2))%" title="RM@(Model.TrendValues[i].ToString("0.00")) on @Model.TrendLabels[i]"></div>
							<div class="day">@Model.TrendLabels[i]</div>
						</div>
					}
				</div>
			}
		</div>

		<div class="sales-cols">
			<div class="card">
				<div class="card-head">
					<h2>Top selling products</h2>
				</div>
				@if (!Model.TopProducts.Any())
				{
					<div class="empty">No sales data yet.</div>
				}
				else
				{
					@for (int i = 0; i < Model.TopProducts.Count; i++)
					{
						var p = Model.TopProducts[i];
						<div class="tp-row">
							<div class="tp-rank">@(i + 1)</div>
							<div class="tp-name">@p.Name<div class="tp-qty">@p.Qty sold</div></div>
							<div class="tp-rev">RM@(p.Revenue.ToString("0.00"))</div>
						</div>
					}
				}
			</div>

			<div class="card">
				<div class="card-head">
					<h2>Revenue by category</h2>
				</div>
				@if (!Model.CategoryBreakdown.Any())
				{
					<div class="empty">No sales data yet.</div>
				}
				else
				{
					@foreach (var c in Model.CategoryBreakdown)
					{
						var pct = maxCat > 0 ? (double)(c.Revenue / maxCat) * 100 : 0;
						<div class="hbar-row">
							<div class="hbar-top"><b>@c.Category</b><span>RM@(c.Revenue.ToString("0.00"))</span></div>
							<div class="hbar-track"><div class="hbar-fill" style="width:@(pct)%"></div></div>
						</div>
					}
				}
			</div>
		</div>

		<div class="card sales-card">
			<div class="card-head">
				<h2>Orders by status</h2>
			</div>
			@if (!Model.StatusBreakdown.Any())
			{
				<div class="empty">No orders yet.</div>
			}
			else
			{
				@foreach (var s in Model.StatusBreakdown)
				{
					var pct = maxStatus > 0 ? (double)s.Count / maxStatus * 100 : 0;
					<div class="hbar-row">
						<div class="hbar-top"><b>@s.Status</b><span>@s.Count order@(s.Count == 1 ? "" : "s")</span></div>
						<div class="hbar-track"><div class="hbar-fill" style="width:@(pct)%"></div></div>
					</div>
				}
			}
		</div>


		<!-- QUICK LINKS -->
		<div class="section-title">Quick actions</div>
		<div class="quick">
			<a class="qcard" asp-page="/Admin/ProductManagement">
				<span class="qico">🧴</span>
				<h3>Manage products</h3>
				<p>Add, edit, and remove items in your catalogue.</p>
				<span class="go">Open Products →</span>
			</a>
			<a class="qcard" asp-page="/Admin/OrderManagement">
				<span class="qico">🧾</span>
				<h3>View orders</h3>
				<p>Track and update customer orders.</p>
				<span class="go">Open Orders →</span>
			</a>
			<a class="qcard" asp-page="/Admin/SalesDashboard">
				<span class="qico">📊</span>
				<h3>Sales dashboard</h3>
				<p>See revenue and sales trends at a glance.</p>
				<span class="go">Open Sales →</span>
			</a>
		</div>

		<!-- RECENT PRODUCTS -->
		<div class="card">
			<div class="card-head">
				<h2>Recently added products</h2>
				<a class="seeall" asp-page="/Admin/ProductManagement">View all →</a>
			</div>

			@if (Model.RecentProducts.Count == 0)
			{
				<div class="empty">
					No products yet. <a asp-page="/Admin/ProductManagement">Add your first product →</a>
				</div>
			}
			else
			{
				<table class="tbl">
					<thead>
						<tr>
							<th>Product</th>
							<th>Category</th>
							<th>Label</th>
							<th>Price</th>
							<th>Stock</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var p in Model.RecentProducts)
						{
							<tr>
								<td>
									<div class="pname">@p.Name</div>
									<div style="font-size:13px;color:var(--steel)">@p.Brand</div>
								</td>
								<td>@p.Category</td>
								<td><span class="lab lab-@p.Label">@p.Label</span></td>
								<td class="price">RM@(p.Price.ToString("0.00"))</td>
								<td class="@(p.Stock < 10 ? "stock-low" : "")">@p.Stock</td>
							</tr>
						}
					</tbody>
				</table>
			}
		</div>
	</div>
</body>
</html>

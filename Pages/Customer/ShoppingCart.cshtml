@page
@using Healthcare_Industry.Models
@using Healthcare_Industry.Services
@model Healthcare_Industry.Pages.Customer.ShoppingCartModel
@{
    Layout = null;
    ViewData["Title"] = "Shopping Cart";
    var initial = Model.CustomerInitial;
}

@functions {
    string CatEmoji(ProductCategory c) => c switch
    {
        ProductCategory.Supplements => "💊",
        ProductCategory.BathAndBody => "🛁",
        ProductCategory.Beauty => "✨",
        ProductCategory.BabyCare => "🍼",
        ProductCategory.HealthDevices => "🩺",
        _ => "📦"
    };
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Shopping Cart - WellNest</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;1,400;1,500&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700;9..40,800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/customer-pages.css" asp-append-version="true" />
</head>
<body>
    <nav class="nav">
        <div class="nav-in">
            <a class="nav-back-icon" href="javascript:history.back()" aria-label="Back" title="Back">&#8592;</a>
            <a class="logo" asp-page="/Customer/HomePage">
                <span class="orb">🌿</span>
                <span class="name">Well<span>Nest</span></span>
            </a>
            <span class="nav-spacer"></span>
            <partial name="_CartLink" model="@("icon-link")" />
            <a class="nav-link" asp-page="/Customer/History">🧾 My Orders</a>
            <a class="nav-link profile-link" asp-page="/Customer/Profile"><span class="avatar">@initial</span> My Profile</a>
        </div>
    </nav>

    <main class="wrap">
        <section class="page-head">
            <div>
                <div class="eyebrow">Your basket</div>
                <h1>Shopping cart</h1>
                <p>Review quantities, remove items, and choose what to checkout.</p>
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(Model.Message))
        {
            <div class="notice bad auto-dismiss">@Model.Message</div>
        }

        @if (!Model.CartItems.Any())
        {
            <section class="panel empty empty-cart">
                <h2>Your cart is empty</h2>
                <p>Add a few wellness picks and they will appear here.</p>
                <a class="btn btn-primary" asp-page="/Customer/HomePage">Start shopping</a>
            </section>
        }
        else
        {
            <section class="grid-2">
                <div class="panel">
                    <div class="cart-toolbar">
                        <h2 style="margin-bottom:0;">Items</h2>
                        <form id="bulkActionForm" method="post">
                            <button class="btn btn-danger" type="submit" asp-page-handler="RemoveSelected" onclick="return confirm('Delete the selected cart items?');">🗑 Delete selected</button>
                        </form>
                    </div>
                    @foreach (var item in Model.CartItems)
                    {
                        var product = item.Product;
                        if (product is null) { continue; }
                        var isOutOfStock = product.Stock <= 0;

                        <div class="cart-row @(isOutOfStock ? "cart-row-unavailable" : "")">
                            <input class="check cart-select"
                                   form="bulkActionForm"
                                   type="checkbox"
                                   name="selectedItemIds"
                                   value="@item.Id"
                                   disabled="@isOutOfStock"
                                   data-subtotal="@(((product.Price * item.Quantity)).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))"
                                   data-discount="@(Model.GetLineDiscount(item).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))" />
                            <a class="thumb m-@product.Category" asp-page="/Customer/ProductDetails" asp-route-id="@product.Id">
                                @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                {
                                    <img class="product-img" src="@product.ImageUrl" alt="@product.Name" loading="lazy" />
                                }
                                else
                                {
                                    @CatEmoji(product.Category)
                                }
                            </a>
                            <div>
                                <a class="item-name" asp-page="/Customer/ProductDetails" asp-route-id="@product.Id">@product.Name</a>
                                <div class="muted">@product.Brand · RM @product.Price.ToString("0.00") each</div>
                                @if (product.Label == ProductLabel.Buy1Free1)
                                {
                                    <div class="muted">Buy 1 Free 1 applied in cart</div>
                                }
                                <div class="muted">@(isOutOfStock ? "Out of stock" : $"{Math.Max(0, product.Stock)} in stock")</div>
                            </div>
                            <div class="price">
                                RM @Model.GetLineTotal(item).ToString("0.00")
                                @if (Model.GetLineDiscount(item) > 0)
                                {
                                    <div class="muted">Saved RM @Model.GetLineDiscount(item).ToString("0.00")</div>
                                }
                            </div>
                            <form class="qty" method="post" asp-page-handler="UpdateQty">
                                <input type="hidden" name="cartItemId" value="@item.Id" />
                                <input class="input" type="number" name="quantity" min="1" max="@Math.Max(1, product.Stock)" value="@item.Quantity" disabled="@isOutOfStock" onchange="this.form.submit()" />
                            </form>
                            <form method="post" asp-page-handler="Remove" onsubmit="return confirm('Delete this item from your cart?');">
                                <input type="hidden" name="cartItemId" value="@item.Id" />
                                <button class="btn btn-danger" type="submit" title="Remove">🗑</button>
                            </form>
                        </div>
                    }
                </div>

                <aside class="summary">
                    <h2>Order summary</h2>
                    <div class="row"><span>Subtotal</span><strong id="selectedSubtotal">RM 0.00</strong></div>
                    <div class="row"><span>Discounts</span><strong id="selectedDiscount">- RM 0.00</strong></div>
                    <div class="row"><span>Shipping</span><strong id="selectedShipping">RM 0.00</strong></div>
                    <div class="row total"><span>Total</span><strong id="selectedTotal">RM 0.00</strong></div>
                    <button class="btn btn-primary js-checkout-button" style="width:100%;margin-top:16px;" type="submit" form="bulkActionForm" asp-page-handler="CheckoutSelected">Checkout</button>
                    <p class="muted" id="selectionHint" style="margin-top:12px;">Select item(s) to calculate checkout total. Free shipping from RM 120.</p>
                </aside>
            </section>
        }
    </main>

    <partial name="_CustomerFooter" />
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        const itemChecks = Array.from(document.querySelectorAll('.cart-select'));
        const checkoutButtons = Array.from(document.querySelectorAll('.js-checkout-button'));
        const subtotalEl = document.getElementById('selectedSubtotal');
        const discountEl = document.getElementById('selectedDiscount');
        const shippingEl = document.getElementById('selectedShipping');
        const totalEl = document.getElementById('selectedTotal');
        const hintEl = document.getElementById('selectionHint');
        const selectedStorageKey = 'wellnest-cart-selected-items';
        const bulkActionForm = document.getElementById('bulkActionForm');

        function getStoredSelectedIds() {
            try {
                return new Set(JSON.parse(localStorage.getItem(selectedStorageKey) || '[]').map(String));
            } catch {
                return new Set();
            }
        }

        function storeSelectedIds() {
            const selectedIds = itemChecks
                .filter(check => check.checked)
                .map(check => check.value);
            localStorage.setItem(selectedStorageKey, JSON.stringify(selectedIds));
        }

        function restoreSelectedIds() {
            const selectedIds = getStoredSelectedIds();
            itemChecks.forEach(check => {
                check.checked = selectedIds.has(check.value);
            });
        }

        function money(value) {
            return `RM ${value.toFixed(2)}`;
        }

        function updateSelectedTotals() {
            const selected = itemChecks.filter(check => check.checked);
            const subtotal = selected.reduce((sum, check) => sum + Number(check.dataset.subtotal || 0), 0);
            const discount = selected.reduce((sum, check) => sum + Number(check.dataset.discount || 0), 0);
            const shipping = subtotal === 0 || subtotal >= 120 ? 0 : 8;
            const total = Math.max(0, subtotal - discount + shipping);

            subtotalEl.textContent = money(subtotal);
            discountEl.textContent = `- ${money(discount)}`;
            shippingEl.textContent = shipping === 0 ? (subtotal === 0 ? 'RM 0.00' : 'Free') : money(shipping);
            totalEl.textContent = money(total);
            hintEl.textContent = selected.length === 0
                ? 'Select item(s) to calculate checkout total. Free shipping from RM 120.'
                : `${selected.length} item${selected.length === 1 ? '' : 's'} selected for checkout.`;
            checkoutButtons.forEach(button => button.disabled = selected.length === 0);
        }

        itemChecks.forEach(check => check.addEventListener('change', () => {
            storeSelectedIds();
            updateSelectedTotals();
        }));
        if (bulkActionForm) {
            bulkActionForm.addEventListener('submit', () => localStorage.removeItem(selectedStorageKey));
        }
        restoreSelectedIds();
        updateSelectedTotals();
    </script>
</body>
</html>

@page
@using Healthcare_Industry.Models
@model Healthcare_Industry.Pages.Customer.HistoryModel
@{
    Layout = null;
    ViewData["Title"] = "Order History";
    var statuses = new[] { "All", "Pending", "Packed", "Shipped", "Delivered", "Cancelled" };
    var initial = Model.CustomerInitial;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Order History - WellNest</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;1,400;1,500&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700;9..40,800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/customer-pages.css" asp-append-version="true" />
</head>
<body>
    <nav class="nav">
        <div class="nav-in">
            <a class="nav-back-icon" href="javascript:history.back()" aria-label="Back" title="Back">&#8592;</a>
            <a class="logo" asp-page="/Customer/HomePage">
                <span class="orb">🌿</span>
                <span class="name">Well<span>Nest</span></span>
            </a>
            <span class="nav-spacer"></span>
            <partial name="_CartLink" model="@("icon-link")" />
            <a class="nav-link" asp-page="/Customer/History">🧾 My Orders</a>
            <a class="nav-link profile-link" asp-page="/Customer/Profile"><span class="avatar">@initial</span> My Profile</a>
        </div>
    </nav>

    <main class="wrap">
        <section class="page-head">
            <div>
                <div class="eyebrow">My orders</div>
                <h1>Order history</h1>
                <p>Track active deliveries and review past WellNest purchases.</p>
            </div>
        </section>

        <section class="stats">
            <div class="stat"><strong>@Model.TotalOrders</strong><span class="muted">Total orders</span></div>
            <div class="stat"><strong>@Model.ActiveOrders</strong><span class="muted">In progress</span></div>
            <div class="stat"><strong>@Model.DeliveredOrders</strong><span class="muted">Delivered</span></div>
            <div class="stat"><strong>RM @Model.TotalSpent.ToString("0")</strong><span class="muted">Total spent</span></div>
        </section>

        <section class="page-head" style="padding:24px 0 8px;">
            <div class="status-pills">
                @foreach (var status in statuses)
                {
                    <a class="pill @(Model.Status == status ? "active" : "")" asp-page="/Customer/History" asp-route-status="@(status == "All" ? null : status)">@status</a>
                }
            </div>
        </section>

        @if (!Model.Orders.Any())
        {
            <section class="panel empty">
                <h2>No orders found</h2>
                <p>Your matching orders will appear here.</p>
                <a class="btn btn-primary" asp-page="/Customer/HomePage">Shop now</a>
            </section>
        }
        else
        {
            @foreach (var order in Model.Orders)
            {
                <article class="order-card">
                    <div class="order-top">
                        <div>
                            <div class="eyebrow">Order #@order.Id</div>
                            <h2>@order.Items.Count item@(order.Items.Count == 1 ? "" : "s") · RM @order.Total.ToString("0.00")</h2>
                            <p class="muted">@order.OrderDate.ToLocalTime().ToString("dd MMM yyyy, h:mm tt") · Payment: @order.PaymentStatus · @order.DeliveryAddress</p>
                        </div>
                        <span class="badge @order.Status">@order.Status</span>
                    </div>
                    <div class="row" style="border-top:1px solid var(--mist);margin-top:14px;padding-top:14px;">
                        <span class="muted">@string.Join(", ", order.Items.Take(3).Select(i => i.ProductName))</span>
                        @if (order.Status == OrderStatus.Delivered && Model.ReviewedOrderIds.Contains(order.Id))
                        {
                            <a class="btn btn-reviewed" asp-page="/Customer/Tracking" asp-route-id="@order.Id" aria-label="View your review for order @order.Id">
                                <span aria-hidden="true">✓</span> Reviewed
                            </a>
                        }
                        else
                        {
                            <a class="btn btn-secondary" asp-page="/Customer/Tracking" asp-route-id="@order.Id">@(order.Status == OrderStatus.Delivered ? "Review" : "Track")</a>
                        }
                    </div>
                </article>
            }
        }
    </main>

    <partial name="_CustomerFooter" />
</body>
</html>

@page
@using Healthcare_Industry.Services
@model Healthcare_Industry.Pages.Customer.ProfileModel
@{
    Layout = null;
    ViewData["Title"] = "Profile";
    var initial = CustomerDisplayService.GetInitial(Model.Profile.FullName, Model.Profile.Email);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Profile - WellNest</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;1,400;1,500&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700;9..40,800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/customer-pages.css" asp-append-version="true" />
</head>
<body>
    <nav class="nav">
        <div class="nav-in">
            <a class="nav-back-icon" href="javascript:history.back()" aria-label="Back" title="Back">&#8592;</a>
            <a class="logo" asp-page="/Customer/HomePage">
                <span class="orb">🌿</span>
                <span class="name">Well<span>Nest</span></span>
            </a>
            <span class="nav-spacer"></span>
            <partial name="_CartLink" model="@("icon-link")" />
            <a class="nav-link" asp-page="/Customer/History">🧾 My Orders</a>
            <a class="nav-link profile-link" asp-page="/Customer/Profile"><span class="avatar">@initial</span> My Profile</a>
        </div>
    </nav>

    <main class="wrap">
        <section class="page-head">
            <div>
                <div class="eyebrow">My account</div>
                <h1>Profile</h1>
                <p>Keep your delivery details up to date and manage your password.</p>
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(Model.Message))
        {
            <div class="notice auto-dismiss @(Model.IsSuccess ? "good" : "bad")">@Model.Message</div>
        }
        <section class="profile-layout">
            <aside class="panel side-nav">
                <a class="active" href="#personal">Personal info</a>
                <a href="#" onclick="event.preventDefault(); document.getElementById('logoutForm').submit();" style="color:#e8524a;">Log out</a>
            </aside>

            <form id="logoutForm" method="post" asp-page="/Account/Logout" style="display:none;"></form>

            <div style="display:grid;gap:22px;">
                <form id="personal" class="panel" method="post" asp-page-handler="SaveProfile">
                    <h2>Personal information</h2>
                    <div class="form-grid">
                        <div class="field">
                            <label asp-for="Profile.FullName">Full name</label>
                            <input class="input" asp-for="Profile.FullName" />
                            <span class="muted" asp-validation-for="Profile.FullName"></span>
                        </div>
                        <div class="field">
                            <label asp-for="Profile.Email">Email</label>
                            <input class="input" asp-for="Profile.Email" />
                            <span class="muted" asp-validation-for="Profile.Email"></span>
                        </div>
                        <div class="field">
                            <label asp-for="Profile.PhoneNumber">Phone</label>
                            <input class="input" asp-for="Profile.PhoneNumber" />
                            <span class="muted" asp-validation-for="Profile.PhoneNumber"></span>
                        </div>
                        <div class="field full">
                            <label asp-for="Profile.Address">Default address</label>
                            <textarea class="textarea" asp-for="Profile.Address"></textarea>
                            <span class="muted" asp-validation-for="Profile.Address"></span>
                        </div>
                    </div>
                    <button class="btn btn-primary" type="submit" style="margin-top:18px;">Save profile</button>
                </form>

                <form id="security" class="panel" method="post" asp-page-handler="ChangePassword">
                    <h2>Change password</h2>
                    <p class="muted" style="margin-top:-8px;">Leave this section blank unless you want to update your password.</p>
                    <div class="form-grid">
                        <div class="field full">
                            <label asp-for="Password.CurrentPassword">Current password</label>
                            <input class="input" asp-for="Password.CurrentPassword" />
                            <span class="muted" asp-validation-for="Password.CurrentPassword"></span>
                        </div>
                        <div class="field">
                            <label asp-for="Password.NewPassword">New password</label>
                            <input class="input" asp-for="Password.NewPassword" />
                            <span class="muted" asp-validation-for="Password.NewPassword"></span>
                        </div>
                        <div class="field">
                            <label asp-for="Password.ConfirmPassword">Confirm password</label>
                            <input class="input" asp-for="Password.ConfirmPassword" />
                            <span class="muted" asp-validation-for="Password.ConfirmPassword"></span>
                        </div>
                    </div>
                    <button class="btn btn-secondary" type="submit" style="margin-top:18px;">Update password</button>
                </form>
            </div>
        </section>
    </main>

    <partial name="_CustomerFooter" />
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
